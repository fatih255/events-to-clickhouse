{
  "name": "events-to-clickhouse",
  "version": "1.0.0",
  "description": "Popup analytics events from an HTTP collector through SQS into ClickHouse, with a Postgres comparison.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "migrate": "tsx scripts/migrate.ts",
    "collector": "tsx src/collector/main.ts",
    "writer": "tsx src/writer/main.ts",
    "dashboard": "tsx src/dashboard/main.ts",
    "traffic": "tsx scripts/demo-traffic.ts",
    "check:read-paths": "tsx scripts/compare-read-paths.ts",
    "bench": "tsx scripts/bench.ts",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1165.0",
    "@clickhouse/client": "1.25.0",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "pg-copy-streams": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/pg-copy-streams": "1.2.5",
    "eslint": "10.14.0",
    "playwright": "1.64.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
