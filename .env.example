# Local-only credentials for the Docker services. Not secrets; change them if you like.
CLICKHOUSE_USER=etc
CLICKHOUSE_PASSWORD=etc_local_only
POSTGRES_USER=etc
POSTGRES_PASSWORD=etc_local_only

# Defaults used by the npm scripts when they run on the host.
CLICKHOUSE_URL=http://localhost:18123
SQS_ENDPOINT=http://localhost:18125
POSTGRES_URL=postgres://etc:etc_local_only@localhost:15432/bench
